diff --git a/data_socket.go b/data_socket.go
index 276c4fa..6264e5c 100644
--- a/data_socket.go
+++ b/data_socket.go
@@ -212,0 +213,9 @@ func (socket *passiveSocket) Close() error {
+func sameTCPPeerIP(left, right net.Addr) bool {
+	leftTCP, leftOK := left.(*net.TCPAddr)
+	rightTCP, rightOK := right.(*net.TCPAddr)
+	if !leftOK || !rightOK || leftTCP.IP == nil || rightTCP.IP == nil {
+		return false
+	}
+	return leftTCP.IP.Equal(rightTCP.IP)
+}
+
@@ -254,3 +263,15 @@ func (socket *passiveSocket) ListenAndServe() (err error) {
-		conn, err := listener.Accept()
-		if err != nil {
-			socket.err = err
+		for {
+			conn, acceptErr := listener.Accept()
+			if acceptErr != nil {
+				socket.err = acceptErr
+				return
+			}
+			if !sameTCPPeerIP(socket.sess.RemoteAddr(), conn.RemoteAddr()) {
+				_ = conn.Close()
+				continue
+			}
+			socket.err = nil
+			socket.conn = conn
+			socket.reader = ratelimit.Reader(socket.conn, socket.sess.server.rateLimiter)
+			socket.writer = ratelimit.Writer(socket.conn, socket.sess.server.rateLimiter)
+			_ = listener.Close()
