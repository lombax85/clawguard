# Copy this file to .env. The real .env is intentionally ignored by Git.

# Required when clawguard.yaml references ${TELEGRAM_BOT_TOKEN}.
TELEGRAM_BOT_TOKEN=

# Address on the ClawGuard host where the experimental SSH and FTP gateways
# accept clients. The Compose default is 127.0.0.1; use a specific LAN address
# when the client runs on another machine.
CLAWGUARD_GATEWAY_BIND_IP=127.0.0.1

# Optional: override these only when passive FTP or the FTPS certificate must
# advertise a value different from CLAWGUARD_GATEWAY_BIND_IP.
# CLAWGUARD_FTP_PUBLIC_IP=192.168.1.50
# CLAWGUARD_FTP_TLS_HOSTNAME=clawguard.example.com
